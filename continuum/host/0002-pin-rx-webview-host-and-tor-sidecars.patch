diff --git a/wallet/tor/windows/tor-sidecar.ps1 b/wallet/tor/windows/tor-sidecar.ps1
new file mode 100644
index 0000000..e7c1539
--- /dev/null
+++ b/wallet/tor/windows/tor-sidecar.ps1
@@ -0,0 +1,41 @@
+# Windows Tor sidecar pin for Rx. Does not download or vendor tor.exe.
+# Port 1080 is the VPN proxy and is refused. A missing binary stays unprivate.
+$ErrorActionPreference = "Stop"
+$socks = if ($env:RX_SOCKS_PORT) { $env:RX_SOCKS_PORT } else { "9070" }
+$control = if ($env:RX_CONTROL_PORT) { $env:RX_CONTROL_PORT } else { "9071" }
+$mode = if ($args.Count -gt 0) { $args[0] } else { "check" }
+
+function Refuse {
+  Write-Output "unprivate unless tor"
+  exit 2
+}
+
+if ($socks -eq "1080" -or $control -eq "1080" -or $mode -eq "1080") {
+  Refuse
+}
+
+$tor = if ($env:RX_TOR_BIN) { $env:RX_TOR_BIN } else { "tor.exe" }
+$cmd = Get-Command $tor -ErrorAction SilentlyContinue
+if (-not $cmd) {
+  Refuse
+}
+
+if ($mode -eq "check") {
+  Write-Output "private via tor pin socks=127.0.0.1:$socks"
+  exit 0
+}
+
+if ($mode -ne "start") {
+  Refuse
+}
+
+$data = if ($env:RX_TOR_DATA) { $env:RX_TOR_DATA } else { Join-Path $env:LOCALAPPDATA "rx-privacy-browser\tor" }
+if ($data -match "shewall|shear-wallet|shear_wallet") {
+  Refuse
+}
+New-Item -ItemType Directory -Force -Path $data | Out-Null
+& $cmd.Source `
+  --SocksPort "127.0.0.1:$socks" `
+  --ControlPort "127.0.0.1:$control" `
+  --CookieAuthentication 1 `
+  --DataDirectory $data
