@@ -0,0 +1,134 @@
+/// Tor SOCKS bridge pin for the Rx Privacy Browser chip.
+///
+/// CODEBASE-RX-TOR-MAP. This library does not vendor Tor, does not add
+/// `webview_flutter` to the wallet, and does not fetch browser pages.
+/// A missing sidecar binary keeps the chip on `unprivate unless tor`.
+library;
+
+import 'shear_rx_host.dart';
+
+const kRxWebViewPackage = 'webview_flutter';
+const kRxWebViewVersion = '4.13.0';
+
+/// Linux and Windows release builds have no implementation of this package.
+/// It stays out of pubspec until those builds are proven with it linked.
+const kRxWebViewInPubspec = false;
+
+/// No public vort1 origin is published. The example host is documentation.
+const String? kLiveVort1Origin = null;
+const kExampleVort1Origin =
+    'https://rx-privacy-browser.example/vortice/rx-privacy-browser.vortice.json';
+const kGalleryReady = false;
+
+const kRxSocksHost = '127.0.0.1';
+const kRxSocksPort = 9070;
+const kRxControlPort = 9071;
+
+class TorSidecarPin {
+  const TorSidecarPin({
+    required this.platform,
+    required this.binary,
+    required this.socksHost,
+    required this.socksPort,
+    required this.controlHost,
+    required this.controlPort,
+    required this.vendored,
+  });
+
+  final String platform;
+  final String binary;
+  final String socksHost;
+  final int socksPort;
+  final String controlHost;
+  final int controlPort;
+  final bool vendored;
+}
+
+const kTorSidecars = <String, TorSidecarPin>{
+  'android': TorSidecarPin(
+    platform: 'android',
+    binary: 'libtor.so',
+    socksHost: kRxSocksHost,
+    socksPort: kRxSocksPort,
+    controlHost: kRxSocksHost,
+    controlPort: kRxControlPort,
+    vendored: false,
+  ),
+  'linux': TorSidecarPin(
+    platform: 'linux',
+    binary: 'tor',
+    socksHost: kRxSocksHost,
+    socksPort: kRxSocksPort,
+    controlHost: kRxSocksHost,
+    controlPort: kRxControlPort,
+    vendored: false,
+  ),
+  'macos': TorSidecarPin(
+    platform: 'macos',
+    binary: 'tor',
+    socksHost: kRxSocksHost,
+    socksPort: kRxSocksPort,
+    controlHost: kRxSocksHost,
+    controlPort: kRxControlPort,
+    vendored: false,
+  ),
+  'windows': TorSidecarPin(
+    platform: 'windows',
+    binary: 'tor.exe',
+    socksHost: kRxSocksHost,
+    socksPort: kRxSocksPort,
+    controlHost: kRxSocksHost,
+    controlPort: kRxControlPort,
+    vendored: false,
+  ),
+};
+
+/// Page loads must not use `url_launcher`. Social links stay external elsewhere.
+bool rxBrowserMayUseUrlLauncher() => false;
+
+/// True only for a loopback sidecar that is not the VPN port and is not vendored
+/// into this tree. Presence of the binary is a separate check.
+bool sidecarRelayAllowed(TorSidecarPin pin) {
+  if (pin.vendored) return false;
+  if (pin.socksPort == kVpnProxyPort || pin.controlPort == kVpnProxyPort) {
+    return false;
+  }
+  if (pin.socksHost != '127.0.0.1' && pin.socksHost != '::1') return false;
+  if (pin.controlHost != '127.0.0.1' && pin.controlHost != '::1') return false;
+  if (pin.binary.isEmpty) return false;
+  return true;
+}
+
+/// Missing binary, a bad pin, or a down circuit: exact unprivate status.
+String sidecarStatus({
+  required String platform,
+  required bool binaryPresent,
+  required RxTorState tor,
+}) {
+  final pin = kTorSidecars[platform];
+  if (pin == null || !sidecarRelayAllowed(pin) || !binaryPresent) {
+    return unprivateUnlessTor;
+  }
+  if (tor.socksPort == kVpnProxyPort) return unprivateUnlessTor;
+  return rxStatusLine(tor);
+}
+
+RxTorState sidecarTorState({
+  required String platform,
+  required bool binaryPresent,
+  required bool bootstrapped,
+  required bool circuitEstablished,
+  required bool socksListening,
+}) {
+  final pin = kTorSidecars[platform];
+  if (pin == null || !binaryPresent) return RxTorState.down;
+  return RxTorState(
+    socksListening: socksListening,
+    bootstrapped: bootstrapped,
+    bootstrapProgress: bootstrapped ? 100 : 0,
+    circuitEstablished: circuitEstablished,
+    socksHost: pin.socksHost,
+    socksPort: pin.socksPort,
+    vpnRelay: false,
+  );
+}
