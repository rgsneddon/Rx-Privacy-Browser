+#!/bin/sh
+# Linux Tor sidecar pin for Rx. Does not download or vendor tor.
+# Port 1080 is the VPN proxy and is refused. A missing binary stays unprivate.
+set -eu
+SOCKS_PORT="${RX_SOCKS_PORT:-9070}"
+CONTROL_PORT="${RX_CONTROL_PORT:-9071}"
+MODE="${1:-check}"
+
+refuse() {
+  echo "unprivate unless tor"
+  exit 2
+}
+
+if [ "$SOCKS_PORT" = "1080" ] || [ "$CONTROL_PORT" = "1080" ]; then
+  refuse
+fi
+if [ "$MODE" = "1080" ]; then
+  refuse
+fi
+
+TOR_BIN="${RX_TOR_BIN:-tor}"
+if ! command -v "$TOR_BIN" >/dev/null 2>&1; then
+  refuse
+fi
+
+if [ "$MODE" = "check" ]; then
+  echo "private via tor pin socks=127.0.0.1:${SOCKS_PORT}"
+  exit 0
+fi
+
+if [ "$MODE" != "start" ]; then
+  refuse
+fi
+
+DATA="${RX_TOR_DATA:-${HOME}/.local/share/rx-privacy-browser/tor}"
+case "$DATA" in
+  *shewall*|*shear-wallet*|*shear_wallet*) refuse ;;
+esac
+mkdir -p "$DATA"
+exec "$TOR_BIN" \
+  --SocksPort "127.0.0.1:${SOCKS_PORT}" \
+  --ControlPort "127.0.0.1:${CONTROL_PORT}" \
+  --CookieAuthentication 1 \
+  --DataDirectory "$DATA"
