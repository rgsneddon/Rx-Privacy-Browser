diff --git a/wallet/lib/shear_rx_host.dart b/wallet/lib/shear_rx_host.dart
new file mode 100644
index 0000000..90e27c5
--- /dev/null
+++ b/wallet/lib/shear_rx_host.dart
@@ -0,0 +1,263 @@
+/// Isolated host gate for the Rx Privacy Browser vortice.
+///
+/// This file does not read shewall, seeds, or spend keys. It does not open a
+/// peer RPC and it does not touch invent or pool. Navigation is Tor SOCKS or
+/// it does not happen.
+library;
+
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+const rxPrivacyBrowserProgram = 'rx-privacy-browser-v1';
+const unprivateUnlessTor = 'unprivate unless tor';
+const privateViaTor = 'private via tor';
+const kVpnProxyPort = 1080;
+
+const kRxSecretRefusedSend =
+    'Refused. A seed, mnemonic, shewall, or private key cannot enter Send.';
+const kRxSecretRefusedClosure =
+    'Refused. A seed, mnemonic, shewall, or private key cannot enter Closure from Rx.';
+
+/// Channels the isolated view is allowed to expose. Spend and vault names are absent.
+const rxHostChannels = <String>[];
+
+class RxTorState {
+  const RxTorState({
+    required this.socksListening,
+    required this.bootstrapped,
+    required this.bootstrapProgress,
+    required this.circuitEstablished,
+    required this.socksHost,
+    required this.socksPort,
+    this.vpnRelay = false,
+  });
+
+  final bool socksListening;
+  final bool bootstrapped;
+  final int bootstrapProgress;
+  final bool circuitEstablished;
+  final String socksHost;
+  final int socksPort;
+  final bool vpnRelay;
+
+  static const down = RxTorState(
+    socksListening: false,
+    bootstrapped: false,
+    bootstrapProgress: 0,
+    circuitEstablished: false,
+    socksHost: '127.0.0.1',
+    socksPort: 9050,
+  );
+
+  static const routing = RxTorState(
+    socksListening: true,
+    bootstrapped: true,
+    bootstrapProgress: 100,
+    circuitEstablished: true,
+    socksHost: '127.0.0.1',
+    socksPort: 9050,
+  );
+}
+
+bool rxRoutingAllowed(RxTorState state) {
+  if (state.vpnRelay) return false;
+  if (state.socksPort == kVpnProxyPort) return false;
+  if (state.socksHost != '127.0.0.1' && state.socksHost != '::1') return false;
+  if (!state.socksListening) return false;
+  if (!state.bootstrapped || state.bootstrapProgress < 100) return false;
+  if (!state.circuitEstablished) return false;
+  return true;
+}
+
+String rxStatusLine(RxTorState state) =>
+    rxRoutingAllowed(state) ? privateViaTor : unprivateUnlessTor;
+
+/// Bridge object injected for an out-of-process view. No spend, seed, or shewall fields.
+Map<String, Object> rxHostBridge(RxTorState state) {
+  final routing = rxRoutingAllowed(state);
+  return {
+    'isolatedTorWebView': true,
+    'outOfProcess': true,
+    'sharesCookies': false,
+    'sharesStorage': false,
+    'channels': rxHostChannels,
+    'routing': routing,
+    'private': routing,
+    'bootstrapped': state.bootstrapped && state.bootstrapProgress >= 100,
+    'bootstrapProgress': state.bootstrapProgress,
+    'circuitEstablished': state.circuitEstablished,
+    'vpnRelay': false,
+    'socksListening': state.socksListening,
+    'socksHost': state.socksHost,
+    'socksPort': state.socksPort,
+    'status': rxStatusLine(state),
+  };
+}
+
+bool rxHostExposesSpend(Map<String, Object> bridge) {
+  const banned = {'seed', 'seedhex', 'shewall', 'spend', 'keys', 'mnemonic', 'closure', 'send'};
+  for (final key in bridge.keys) {
+    if (banned.contains(key.toLowerCase())) return true;
+  }
+  final channels = bridge['channels'];
+  if (channels is List) {
+    for (final name in channels) {
+      if (banned.contains(name.toString().toLowerCase())) return true;
+    }
+  }
+  return false;
+}
+
+String? rxBrowserHtml(String? source) {
+  if (source == null || source.isEmpty) return null;
+  Object? decoded;
+  try {
+    decoded = jsonDecode(source);
+  } catch (_) {
+    return null;
+  }
+  if (decoded is! Map) return null;
+  if (decoded['kind'] != 'continuum-dapp') return null;
+  if (decoded['programId'] != rxPrivacyBrowserProgram) return null;
+  if (decoded['vpnRelay'] == true) return null;
+  final html = decoded['browser.html'];
+  if (html is! String || html.isEmpty) return null;
+  return html;
+}
+
+final _mnemonicWord = RegExp(r'^[a-z]{3,8}$');
+final _secretHex = RegExp(r'^[0-9a-fA-F]{64}$|^[0-9a-fA-F]{128}$');
+final _xprv = RegExp(r'(?:^|\s)xprv[1-9a-z]{10,}');
+
+/// Reason a paste is secret material, or null. The reason does not echo the text.
+String? secretPasteReason(String? raw) {
+  final text = (raw ?? '').trim();
+  if (text.isEmpty) return null;
+  final low = text.toLowerCase();
+  if (low.contains('shewall')) return 'shewall';
+  if (low.contains('begin private key') ||
+      low.contains('begin openssh private key') ||
+      low.contains('begin ec private key')) {
+    return 'private-key';
+  }
+  if (_xprv.hasMatch(low)) return 'private-key';
+  if (_secretHex.hasMatch(text)) return 'private-key';
+  final words = low.split(RegExp(r'\s+'));
+  const lengths = {12, 15, 18, 21, 24};
+  if (lengths.contains(words.length) && words.every(_mnemonicWord.hasMatch)) {
+    return 'mnemonic';
+  }
+  return null;
+}
+
+bool rxAcceptsPaste(String? raw) => secretPasteReason(raw) == null;
+
+bool sendAcceptsFromRx(String? raw) => secretPasteReason(raw) == null;
+
+bool closureAcceptsFromRx(String? raw) => secretPasteReason(raw) == null;
+
+bool closurePathFromRx(String path) {
+  final low = path.toLowerCase();
+  return low.contains('rx-privacy-browser') || low.contains('rx_privacy_browser');
+}
+
+class RxSocksRefuse implements Exception {
+  RxSocksRefuse() : status = unprivateUnlessTor;
+  final String status;
+  @override
+  String toString() => status;
+}
+
+/// Open a Tor SOCKS connection. Hostnames, including .onion, are not resolved here.
+Future<Socket> rxTorSocksConnect({
+  required RxTorState tor,
+  required String host,
+  required int port,
+}) async {
+  if (!rxRoutingAllowed(tor)) throw RxSocksRefuse();
+  if (port < 1 || port > 65535) throw RxSocksRefuse();
+  final InternetAddress socksIp;
+  try {
+    socksIp = InternetAddress(tor.socksHost);
+  } catch (_) {
+    throw RxSocksRefuse();
+  }
+  if (!socksIp.isLoopback) throw RxSocksRefuse();
+  final sock = await Socket.connect(socksIp, tor.socksPort, timeout: const Duration(seconds: 5));
+  final reader = _SockBuf(sock);
+  try {
+    sock.add(const [0x05, 0x01, 0x00]);
+    await sock.flush();
+    final greeting = await reader.take(2);
+    if (greeting[0] != 5 || greeting[1] != 0) {
+      throw RxSocksRefuse();
+    }
+    final name = Uint8List.fromList(utf8.encode(host));
+    if (name.isEmpty || name.length > 255) throw RxSocksRefuse();
+    final req = Uint8List(7 + name.length);
+    req[0] = 5;
+    req[1] = 1;
+    req[2] = 0;
+    req[3] = 3;
+    req[4] = name.length;
+    req.setRange(5, 5 + name.length, name);
+    req[5 + name.length] = (port >> 8) & 0xff;
+    req[6 + name.length] = port & 0xff;
+    sock.add(req);
+    await sock.flush();
+    final hdr = await reader.take(4);
+    if (hdr[0] != 5 || hdr[1] != 0) throw RxSocksRefuse();
+    final atyp = hdr[3];
+    if (atyp == 1) {
+      await reader.take(6);
+    } else if (atyp == 4) {
+      await reader.take(18);
+    } else if (atyp == 3) {
+      final ln = (await reader.take(1))[0];
+      await reader.take(ln + 2);
+    } else {
+      throw RxSocksRefuse();
+    }
+  } catch (e) {
+    await reader.close();
+    await sock.close();
+    if (e is RxSocksRefuse) rethrow;
+    throw RxSocksRefuse();
+  }
+  return sock;
+}
+
+class _SockBuf {
+  _SockBuf(Socket sock) {
+    _sub = sock.listen((chunk) {
+      _data.addAll(chunk);
+    }, onError: (Object e, StackTrace st) {
+      _failed = e;
+    }, onDone: () {
+      _done = true;
+    });
+  }
+
+  final List<int> _data = [];
+  late final StreamSubscription<List<int>> _sub;
+  Object? _failed;
+  var _done = false;
+
+  Future<Uint8List> take(int n) async {
+    final start = DateTime.now();
+    while (_data.length < n) {
+      if (_failed != null || _done) throw RxSocksRefuse();
+      if (DateTime.now().difference(start) > const Duration(seconds: 5)) {
+        throw RxSocksRefuse();
+      }
+      await Future<void>.delayed(const Duration(milliseconds: 5));
+    }
+    final got = Uint8List.fromList(_data.sublist(0, n));
+    _data.removeRange(0, n);
+    return got;
+  }
+
+  Future<void> close() => _sub.cancel();
+}
diff --git a/wallet/lib/shear_rx_pane.dart b/wallet/lib/shear_rx_pane.dart
new file mode 100644
index 0000000..f73c9d2
--- /dev/null
+++ b/wallet/lib/shear_rx_pane.dart
@@ -0,0 +1,77 @@
+/// In-wallet surface for Rx. It does not receive a Shear identity, seed, or shewall.
+///
+/// The browser document stays out of the spend isolate. Remote fetches go through
+/// Tor SOCKS or they are refused. There is no JavaScript channel to Spendable.
+import 'package:flutter/material.dart';
+
+import 'shear_rx_host.dart';
+
+class RxHostPane extends StatefulWidget {
+  const RxHostPane({super.key, required this.source, this.tor = RxTorState.down});
+
+  final String? source;
+  final RxTorState tor;
+
+  @override
+  State<RxHostPane> createState() => RxHostPaneState();
+}
+
+class RxHostPaneState extends State<RxHostPane> {
+  final _url = TextEditingController();
+  String _panel = '';
+
+  @override
+  void dispose() {
+    _url.dispose();
+    super.dispose();
+  }
+
+  void _go() {
+    final raw = _url.text;
+    if (!rxAcceptsPaste(raw)) {
+      _url.clear();
+      setState(() => _panel = '${rxStatusLine(widget.tor)}\nRefused.');
+      return;
+    }
+    if (!rxRoutingAllowed(widget.tor)) {
+      setState(() => _panel = '$unprivateUnlessTor\nNot fetched.');
+      return;
+    }
+    setState(() => _panel = '$privateViaTor\nTor SOCKS only.');
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final bridge = rxHostBridge(widget.tor);
+    final html = rxBrowserHtml(widget.source);
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        Text(rxStatusLine(widget.tor), key: const Key('rx-status')),
+        const SizedBox(height: 8),
+        const Text(
+          'Out of process. No shared cookies or storage. No bridge to Spendable, shewall, or keys.',
+        ),
+        TextField(
+          key: const Key('rx-url'),
+          controller: _url,
+          decoration: const InputDecoration(labelText: 'Address'),
+          onSubmitted: (_) => _go(),
+        ),
+        const SizedBox(height: 8),
+        FilledButton(
+          key: const Key('rx-go'),
+          onPressed: _go,
+          child: const Text('Go'),
+        ),
+        const SizedBox(height: 8),
+        Text(_panel, key: const Key('rx-panel')),
+        if (html == null)
+          const Text('Browser body is not in this chip yet.')
+        else
+          const Text('Browser body is held for the isolated Tor view.'),
+        if (bridge['vpnRelay'] == true) const Text('vpn relay refused'),
+      ],
+    );
+  }
+}
