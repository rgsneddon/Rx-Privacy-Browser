@@ -0,0 +1,73 @@
+import 'dart:io';
+
+import '../lib/shear_rx_host.dart';
+
+void main() async {
+  if (rxStatusLine(RxTorState.down) != unprivateUnlessTor) {
+    throw StateError('down status');
+  }
+  if (rxRoutingAllowed(RxTorState.routing) != true) {
+    throw StateError('routing');
+  }
+  final bridge = rxHostBridge(RxTorState.down);
+  if (bridge['status'] != unprivateUnlessTor || rxHostExposesSpend(bridge)) {
+    throw StateError('bridge');
+  }
+  if (bridge['channels'] is! List || (bridge['channels'] as List).isNotEmpty) {
+    throw StateError('channels');
+  }
+  final mnemonic = List.filled(11, 'abandon').followedBy(['about']).join(' ');
+  if (secretPasteReason(mnemonic) != 'mnemonic') throw StateError('mnemonic');
+  if (rxAcceptsPaste('shewall.bin')) throw StateError('shewall entered rx');
+  if (sendAcceptsFromRx(mnemonic)) throw StateError('mnemonic entered send');
+  if (closureAcceptsFromRx('ab' * 32)) throw StateError('key entered closure');
+  if (!rxAcceptsPaste('https://example.com/')) throw StateError('clearnet');
+  if (!closurePathFromRx('/tmp/rx-privacy-browser/shewall.bin')) {
+    throw StateError('rx path');
+  }
+  try {
+    await rxTorSocksConnect(tor: RxTorState.down, host: '${'a' * 56}.onion', port: 80);
+    throw StateError('tor down connected');
+  } on RxSocksRefuse {
+    if (unprivateUnlessTor != 'unprivate unless tor') throw StateError('literal');
+  }
+
+  final onion = '${'b' * 56}.onion';
+  final server = await ServerSocket.bind(InternetAddress.loopbackIPv4, 0);
+  final seen = <int>[];
+  server.listen((client) {
+    final data = <int>[];
