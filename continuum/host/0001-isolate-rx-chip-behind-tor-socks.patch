+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shear_wallet/shear_rx_host.dart';
+
+void main() {
+  test('status is unprivate unless tor until a loopback circuit exists', () {
+    expect(rxStatusLine(RxTorState.down), unprivateUnlessTor);
+    expect(rxRoutingAllowed(RxTorState.down), isFalse);
+    final quiet = RxTorState(
+      socksListening: true,
+      bootstrapped: true,
+      bootstrapProgress: 100,
+      circuitEstablished: false,
+      socksHost: '127.0.0.1',
+      socksPort: 9050,
+    );
+    expect(rxStatusLine(quiet), unprivateUnlessTor);
+    final vpn = RxTorState(
+      socksListening: true,
+      bootstrapped: true,
+      bootstrapProgress: 100,
+      circuitEstablished: true,
+      socksHost: '127.0.0.1',
+      socksPort: 1080,
+    );
+    expect(rxRoutingAllowed(vpn), isFalse);
+    expect(rxStatusLine(RxTorState.routing), privateViaTor);
+  });
+
+  test('host bridge has no spend, seed, or shewall channel', () {
+    final bridge = rxHostBridge(RxTorState.down);
+    expect(bridge['status'], unprivateUnlessTor);
+    expect(bridge['vpnRelay'], isFalse);
+    expect(bridge['sharesCookies'], isFalse);
+    expect(bridge['sharesStorage'], isFalse);
+    expect(bridge['outOfProcess'], isTrue);
+    expect(bridge['channels'], isEmpty);
+    expect(rxHostExposesSpend(bridge), isFalse);
+    expect(bridge.containsKey('seed'), isFalse);
+    expect(bridge.containsKey('shewall'), isFalse);
+  });
+
+  test('only the rx continuum body is the isolated document', () {
+    expect(rxBrowserHtml('{"kind":"continuum-dapp","programId":"other"}'), isNull);
+    expect(
+      rxBrowserHtml(
+        '{"kind":"continuum-dapp","programId":"rx-privacy-browser-v1","vpnRelay":true,"browser.html":"<p>x</p>"}',
+      ),
+      isNull,
+    );
+    expect(
+      rxBrowserHtml(
+        '{"kind":"continuum-dapp","programId":"rx-privacy-browser-v1","vpnRelay":false,"browser.html":"<p>rx</p>"}',
+      ),
+      '<p>rx</p>',
+    );
+  });
+
+  test('secret paste is refused into Rx and from Rx into Send and Closure', () {
+    final mnemonic = List.filled(11, 'abandon').followedBy(['about']).join(' ');
+    expect(secretPasteReason(mnemonic), 'mnemonic');
+    expect(rxAcceptsPaste(mnemonic), isFalse);
+    expect(sendAcceptsFromRx(mnemonic), isFalse);
+    expect(closureAcceptsFromRx('shewall.bin'), isFalse);
+    expect(secretPasteReason('ab' * 32), 'private-key');
+    expect(secretPasteReason('https://example.com/'), isNull);
+    expect(rxAcceptsPaste('https://example.com/'), isTrue);
+    expect(closurePathFromRx('/home/me/.local/share/rx-privacy-browser/tor'), isTrue);
+    expect(closurePathFromRx('/tmp/shewall.bin'), isFalse);
+    expect(kRxSecretRefusedSend.contains(mnemonic), isFalse);
+    expect(kRxSecretRefusedClosure.contains('shewall'), isTrue);
+  });
+
+  test('onion connect uses SOCKS hostname and refuses when Tor is down', () async {
+    await expectLater(
+      rxTorSocksConnect(tor: RxTorState.down, host: 'a' * 56 + '.onion', port: 80),
+      throwsA(isA<RxSocksRefuse>()),
+    );
+
+    final onion = '${'b' * 56}.onion';
+    final server = await ServerSocket.bind(InternetAddress.loopbackIPv4, 0);
+    final seen = <int>[];
+    server.listen((client) {
+      final data = <int>[];
+      var greeted = false;
+      client.listen((chunk) {
+        data.addAll(chunk);
+        if (!greeted && data.length >= 3) {
+          greeted = true;
+          client.add(const [5, 0]);
+        }
+        if (greeted && data.length >= 3) {
+          final req = data.sublist(3);
+          if (req.length >= 5 && req.length >= 5 + req[4] + 2 && seen.isEmpty) {
+            seen.addAll(req);
+            client.add(const [5, 0, 0, 1, 0, 0, 0, 0, 0, 0]);
+            client.close();
+          }
+        }
+      });
+    });
+
+    final tor = RxTorState(
+      socksListening: true,
+      bootstrapped: true,
+      bootstrapProgress: 100,
+      circuitEstablished: true,
+      socksHost: '127.0.0.1',
+      socksPort: server.port,
+    );
+    final sock = await rxTorSocksConnect(tor: tor, host: onion, port: 80);
+    await sock.close();
+    await server.close();
+    expect(seen[3], 3);
+    final name = String.fromCharCodes(seen.sublist(5, 5 + seen[4]));
+    expect(name, onion);
+  });
+}
